<resources>
    <!-- AppCompat DayNight: richiesto da AppCompatActivity (lingua per-app).
         forceDarkAllowed=false evita che OEM "force dark" rovini il tema Compose. -->
    <style name="Theme.Clima.App" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">#1F6FEB</item>
        <item name="colorPrimaryDark">#1A4BB0</item>
        <item name="colorAccent">#1F6FEB</item>
        <item name="android:statusBarColor">#F3F5F9</item>
        <item name="android:navigationBarColor">#F3F5F9</item>
        <item name="android:windowBackground">#F3F5F9</item>
        <item name="android:colorBackground">#F3F5F9</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
</resources>
